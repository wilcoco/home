# ㈜캠스 윤리경영 제보 메일 발송 설정 (SMTP)
# 실제 값으로 채운 뒤 .env 로 복사하거나 Railway 환경변수에 등록하세요.
# (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)

# 제보 수신 주소
REPORT_TO=json@icams.co.kr

# 발신 주소 — 자체 메일서버는 자기 도메인 주소로 두는 것이 안전 (relay 거부 방지)
REPORT_FROM=json@icams.co.kr

# SMTP 서버 정보 (icams.co.kr 자체 메일서버 - XMail)
SMTP_HOST=gw.icams.co.kr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=json@icams.co.kr
SMTP_PASS=여기에_json계정_비밀번호

# 구형/자체 메일서버 대응 옵션
# XMail 이 STARTTLS 를 지원하지 않으면 true 로 설정(평문 인증 전송)
SMTP_IGNORE_TLS=false
# 자체서명 인증서 거부 방지를 위해 기본 false. 정식 인증서면 true 권장
SMTP_TLS_REJECT_UNAUTHORIZED=false
