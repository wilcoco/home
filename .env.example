# ㈜캠스 윤리경영 제보 메일 발송 설정 (SMTP)
# 실제 값으로 채운 뒤 .env 로 복사하거나 Railway 환경변수에 등록하세요.
# (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)

# 제보 수신 주소 (기본값: json@icams.co.kr)
REPORT_TO=json@icams.co.kr

# 발신 주소 (미설정 시 SMTP_USER 사용)
REPORT_FROM=no-reply@cams-korea.com

# SMTP 서버 정보
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
