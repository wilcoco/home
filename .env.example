# ㈜캠스 윤리경영 제보 설정
# 실제 값으로 채운 뒤 .env 로 복사하거나 Railway 환경변수에 등록하세요.
# (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)

# === 필수: 관리자 리포트(/admin) 로그인 계정 ===
ADMIN_USER=admin
ADMIN_PASS=여기에_관리자_비밀번호

# === DB 저장 위치 ===
# Railway 는 파일이 휘발성이므로 볼륨을 /data 에 붙이고 아래를 설정하세요.
# (로컬 개발은 비워두면 ./data 사용)
DATA_DIR=/data

# === (선택) 제보 접수 시 메일 알림도 보낼지 ===
# 메일서버 접속이 가능할 때만 true. 기본은 꺼짐(DB 저장만).
MAIL_ON_REPORT=false

# 제보 수신 주소 (MAIL_ON_REPORT=true 일 때만 사용)
REPORT_TO=json@icams.co.kr

# 발신 주소 — 자체 메일서버는 자기 도메인 주소로 두는 것이 안전 (relay 거부 방지)
REPORT_FROM=json@icams.co.kr

# SMTP 서버 정보 (icams.co.kr 자체 메일서버 - XMail)
SMTP_HOST=gw.icams.co.kr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=json@icams.co.kr
SMTP_PASS=여기에_json계정_비밀번호

# 구형/자체 메일서버 대응 옵션
# XMail 이 STARTTLS 를 지원하지 않으면 true 로 설정(평문 인증 전송)
SMTP_IGNORE_TLS=false
# 자체서명 인증서 거부 방지를 위해 기본 false. 정식 인증서면 true 권장
SMTP_TLS_REJECT_UNAUTHORIZED=false

# (선택) 고정 출발지 IP 프록시 - Railway "Static Outbound IPs" 를 쓰면 불필요.
# 다른 호스팅에서 고정 IP가 필요할 때만 사용 (socks 패키지 필요: npm i socks)
# SMTP_PROXY=socks5://user:pass@proxy-host:1080
